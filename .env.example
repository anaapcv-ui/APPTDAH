# Token do bot (obtido no @BotFather)
TELEGRAM_BOT_TOKEN=

# Seu ID numérico do Telegram (descubra mandando /start ao bot ou falando com @userinfobot).
# Vários IDs separados por vírgula. Vazio = qualquer pessoa pode usar (não recomendado).
ALLOWED_USER_IDS=

# Chave da API da Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=
# Modelo usado na leitura dos comprovantes
CLAUDE_MODEL=claude-opus-5-5

# Google Sheets
# Caminho do JSON da service account (ou cole o conteúdo inteiro em GOOGLE_CREDENTIALS_JSON)
GOOGLE_CREDENTIALS_FILE=service_account.json
GOOGLE_CREDENTIALS_JSON=
# ID da planilha: o trecho entre /d/ e /edit na URL
SPREADSHEET_ID=

# Fuso horário para datas
TIMEZONE=America/Sao_Paulo
